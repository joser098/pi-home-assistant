# Sin VITE_SUPABASE_URL (o con VITE_MOCK=1) la app usa datos de ejemplo.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
VITE_VAPID_PUBLIC_KEY=<clave pública VAPID>

# Modo noche del kiosko (horas 0-23)
VITE_NIGHT_START=23
VITE_NIGHT_END=7
# VITE_MOCK=1

# Clima (Open-Meteo, sin API key). Por defecto: Buenos Aires.
VITE_WEATHER_LAT=-34.6037
VITE_WEATHER_LON=-58.3816
VITE_WEATHER_PLACE=Buenos Aires
